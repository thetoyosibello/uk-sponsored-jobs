<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tysitv.sponsored-jobs</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/cryptokyah/projects/sponsored-jobs/local-sweep.sh</string>
    </array>

    <!-- 30 minutes after each cloud run, so the two don't collide on the push -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>8</integer>
            <key>Minute</key><integer>17</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>17</integer>
            <key>Minute</key><integer>17</integer>
        </dict>
    </array>

    <!-- If the Mac was asleep at the scheduled time, run once on wake -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/cryptokyah/projects/sponsored-jobs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cryptokyah/projects/sponsored-jobs/launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/cryptokyah/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
